// Prisma schema for Ethiopia-first e-commerce backend

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  MERCHANT
  ADMIN
}

enum UnitType {
  PIECE
  KG
  LITER
  METER
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  FULFILLING
  PARTIALLY_FULFILLED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  INITIATED
  AUTHORIZED
  CAPTURED
  REFUNDED
  FAILED
}

enum EscrowStatus {
  HOLD
  RELEASED
  PARTIALLY_RELEASED
  REFUNDED
}

enum ShipmentStatus {
  CREATED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
}

enum MessageType {
  TEXT
  SIGNAL
}

enum SenderRole {
  BUYER
  MERCHANT
}

enum ReportStatus {
  OPEN
  RESOLVED
}

model User {
  id                   String                @id @default(cuid())
  phone                String?               @unique
  email                String                @unique
  name                 String?
  role                 Role                  @default(USER)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  addresses            Address[]
  carts                Cart[]
  orders               Order[]
  reviews              Review[]
  loyalty              LoyaltyTransaction[]
  merchant             Merchant?
  qnas                 Qna[]
  conversations        Conversation[]        @relation("UserConversations")
  messages             Message[]
  messageReports       MessageReport[]
  refreshTokens        RefreshToken[]
  wishlists            Wishlist[]
  priceAlerts          PriceAlert[]
  stockNotifications   StockNotification[]
  giftRegistries       GiftRegistry[]
  referralCodes        ReferralCode[]
  referrerTransactions ReferralTransaction[] @relation("ReferrerTransactions")
  refereeTransactions  ReferralTransaction[] @relation("RefereeTransactions")
  bulkOrders           BulkOrder[]
  groupBuyParticipants GroupBuyParticipant[]
  notifications        Notification[]
}

model Otp {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Address {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  label      String?
  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  region     String?
  country    String   @default("ET")
  postalCode String?
  plusCode   String?
  landmark   String?
  lat        Float?
  lon        Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  orders     Order[]
}

model Merchant {
  id                 String              @id @default(cuid())
  ownerId            String              @unique
  owner              User                @relation(fields: [ownerId], references: [id])
  displayName        String
  legalName          String?
  description        String?
  logoUrl            String?
  kyc                MerchantKyc?
  payout             MerchantPayout?
  rating             Float               @default(0)
  lat                Float?
  lon                Float?
  serviceAreas       String[]            @default([])
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  products           Product[]
  inventoryLots      InventoryLot[]
  orders             Order[]
  payouts            Payout[]
  conversations      Conversation[]      @relation("MerchantConversations")
  messages           Message[]
  bulkOrders         BulkOrder[]
  bulkOrderQuotes    BulkOrderQuote[]
  groupBuys          GroupBuy[]
  inventoryMovements InventoryMovement[]
}

model MerchantKyc {
  id          String    @id @default(cuid())
  merchantId  String    @unique
  merchant    Merchant  @relation(fields: [merchantId], references: [id])
  status      KycStatus @default(PENDING)
  documentUrl String?
  notes       String?
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())
}

model MerchantPayout {
  id         String   @id @default(cuid())
  merchantId String   @unique
  merchant   Merchant @relation(fields: [merchantId], references: [id])
  method     String // e.g., bank, wallet
  accountRef String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  parentId  String?
  parent    Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryToCategory")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  products  Product[]
}

model Product {
  id                 String              @id @default(cuid())
  merchantId         String
  merchant           Merchant            @relation(fields: [merchantId], references: [id])
  categoryId         String?
  category           Category?           @relation(fields: [categoryId], references: [id])
  name               String
  slug               String
  description        String?
  images             String[]            @default([])
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  skus               Sku[]
  reviews            Review[]
  qnas               Qna[]
  wishlistItems      WishlistItem[]
  priceAlerts        PriceAlert[]
  stockNotifications StockNotification[]
  giftRegistryItems  GiftRegistryItem[]
  bulkOrderItems     BulkOrderItem[]
  groupBuys          GroupBuy[]

  @@unique([merchantId, slug])
}

model Sku {
  id                    String              @id @default(cuid())
  productId             String
  product               Product             @relation(fields: [productId], references: [id])
  name                  String
  unitType              UnitType
  unitIncrement         Float // e.g., 0.5 kg increments
  packageSize           Float? // e.g., 50 kg bag
  pricePerCanonicalUnit Int // store in cents/ETB*100 for precision
  currency              String              @default("ETB")
  active                Boolean             @default(true)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  inventoryLots         InventoryLot[]
  prices                Price[]
  cartItems             CartItem[]
  orderItems            OrderItem[]
  wishlistItems         WishlistItem[]
  priceAlerts           PriceAlert[]
  stockNotifications    StockNotification[]
  giftRegistryItems     GiftRegistryItem[]
  bulkOrderItems        BulkOrderItem[]
  groupBuys             GroupBuy[]
  inventoryMovements    InventoryMovement[]
}

model InventoryLot {
  id         String    @id @default(cuid())
  merchantId String
  merchant   Merchant  @relation(fields: [merchantId], references: [id])
  skuId      String
  sku        Sku       @relation(fields: [skuId], references: [id])
  quantity   Float // in canonical unit amount (e.g., kg)
  expiry     DateTime?
  locationId String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Price {
  id        String    @id @default(cuid())
  skuId     String
  sku       Sku       @relation(fields: [skuId], references: [id])
  amount    Int // ETB*100
  startsAt  DateTime  @default(now())
  endsAt    DateTime?
  createdAt DateTime  @default(now())
}

model Promotion {
  id          String    @id @default(cuid())
  name        String
  description String?
  startsAt    DateTime  @default(now())
  endsAt      DateTime?
  percentage  Float?
  amountOff   Int?
  active      Boolean   @default(true)
}

model Bundle {
  id     String   @id @default(cuid())
  name   String
  skuIds String[]
  amount Int // ETB*100
}

model Cart {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  cart      Cart   @relation(fields: [cartId], references: [id])
  skuId     String
  sku       Sku    @relation(fields: [skuId], references: [id])
  quantity  Float // requested in canonical units
  unitPrice Int // snapshot in ETB*100
}

model Order {
  id                   String                @id @default(cuid())
  userId               String
  user                 User                  @relation(fields: [userId], references: [id])
  merchantId           String
  merchant             Merchant              @relation(fields: [merchantId], references: [id])
  addressId            String?
  address              Address?              @relation(fields: [addressId], references: [id])
  status               OrderStatus           @default(PENDING)
  totalAmount          Int // ETB*100
  currency             String                @default("ETB")
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  items                OrderItem[]
  payments             Payment[]
  shipments            Shipment[]
  invoice              Invoice?
  referralTransactions ReferralTransaction[]
}

model OrderItem {
  id           String @id @default(cuid())
  orderId      String
  order        Order  @relation(fields: [orderId], references: [id])
  skuId        String
  sku          Sku    @relation(fields: [skuId], references: [id])
  requestedQty Float
  settledQty   Float?
  unitPrice    Int // ETB*100
}

model Payment {
  id         String              @id @default(cuid())
  orderId    String
  order      Order               @relation(fields: [orderId], references: [id])
  provider   String // telebirr | chapa | amole | cod
  status     PaymentStatus       @default(INITIATED)
  amount     Int
  currency   String              @default("ETB")
  escrow     Escrow?
  providerTx PaymentProviderTx[]
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
}

model PaymentProviderTx {
  id        String   @id @default(cuid())
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id])
  extId     String?  @unique
  payload   Json
  createdAt DateTime @default(now())
}

model Escrow {
  id         String       @id @default(cuid())
  paymentId  String       @unique
  payment    Payment      @relation(fields: [paymentId], references: [id])
  status     EscrowStatus @default(HOLD)
  holdAmount Int
  released   Int          @default(0)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

model Shipment {
  id            String          @id @default(cuid())
  orderId       String
  order         Order           @relation(fields: [orderId], references: [id])
  carrier       String
  trackingCode  String?
  otp           String?
  status        ShipmentStatus  @default(CREATED)
  proofPhotoUrl String?
  events        ShipmentEvent[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model ShipmentEvent {
  id         String         @id @default(cuid())
  shipmentId String
  shipment   Shipment       @relation(fields: [shipmentId], references: [id])
  status     ShipmentStatus
  message    String?
  createdAt  DateTime       @default(now())
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  rating    Int
  comment   String?
  images    String[] @default([])
  createdAt DateTime @default(now())
}

model Qna {
  id         String    @id @default(cuid())
  productId  String
  product    Product   @relation(fields: [productId], references: [id])
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  question   String
  answer     String?
  createdAt  DateTime  @default(now())
  answeredAt DateTime?
}

model LoyaltyTransaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  points    Int
  reason    String
  createdAt DateTime @default(now())
}

model Payout {
  id          String    @id @default(cuid())
  merchantId  String
  merchant    Merchant  @relation(fields: [merchantId], references: [id])
  amount      Int // ETB*100
  status      String    @default("PENDING") // PENDING|PROCESSING|PAID|FAILED
  createdAt   DateTime  @default(now())
  processedAt DateTime?
}

model Invoice {
  id          String   @id @default(cuid())
  orderId     String   @unique
  order       Order    @relation(fields: [orderId], references: [id])
  number      String   @unique
  issuedAt    DateTime @default(now())
  totalAmount Int
  vatAmount   Int
  pdfUrl      String?
}

model Conversation {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation("UserConversations", fields: [userId], references: [id])
  merchantId String
  merchant   Merchant     @relation("MerchantConversations", fields: [merchantId], references: [id])
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  messages   Message[]
  invites    ChatInvite[]

  @@unique([userId, merchantId])
}

model Message {
  id               String          @id @default(cuid())
  conversationId   String
  conversation     Conversation    @relation(fields: [conversationId], references: [id])
  senderUserId     String?
  senderUser       User?           @relation(fields: [senderUserId], references: [id])
  senderMerchantId String?
  senderMerchant   Merchant?       @relation(fields: [senderMerchantId], references: [id])
  senderRole       SenderRole
  type             MessageType     @default(TEXT)
  content          String?
  payload          Json?
  readAt           DateTime?
  attachments      String[]        @default([])
  createdAt        DateTime        @default(now())
  reports          MessageReport[]
}

model MessageReport {
  id         String       @id @default(cuid())
  messageId  String
  message    Message      @relation(fields: [messageId], references: [id])
  reporterId String
  reporter   User         @relation(fields: [reporterId], references: [id])
  reason     String
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?
}

model ChatInvite {
  id              String       @id @default(cuid())
  token           String       @unique
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id])
  expiresAt       DateTime
  createdByUserId String
  createdAt       DateTime     @default(now())
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  tokenId    String    @unique
  secretHash String
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
}

// Wishlist Models
model Wishlist {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id])
  name        String
  description String?
  isPublic    Boolean        @default(false)
  shareToken  String?        @unique
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  items       WishlistItem[]
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id])
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  skuId      String?
  sku        Sku?     @relation(fields: [skuId], references: [id])
  quantity   Float    @default(1)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Price Alert Models
model PriceAlert {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  productId   String?
  product     Product?  @relation(fields: [productId], references: [id])
  skuId       String?
  sku         Sku?      @relation(fields: [skuId], references: [id])
  targetPrice Int // ETB*100
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  triggeredAt DateTime?
}

// Stock Notification Models
model StockNotification {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  productId  String
  product    Product   @relation(fields: [productId], references: [id])
  skuId      String?
  sku        Sku?      @relation(fields: [skuId], references: [id])
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  notifiedAt DateTime?
}

// Gift Registry Models
model GiftRegistry {
  id          String             @id @default(cuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id])
  name        String
  description String?
  eventDate   DateTime?
  isPublic    Boolean            @default(false)
  shareToken  String?            @unique
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  items       GiftRegistryItem[]
}

model GiftRegistryItem {
  id                String       @id @default(cuid())
  registryId        String
  registry          GiftRegistry @relation(fields: [registryId], references: [id])
  productId         String
  product           Product      @relation(fields: [productId], references: [id])
  skuId             String?
  sku               Sku?         @relation(fields: [skuId], references: [id])
  quantity          Float
  quantityPurchased Float        @default(0)
  notes             String?
  priority          String?      @default("medium") // high, medium, low
  isPurchased       Boolean      @default(false)
  purchasedBy       String? // User ID who purchased
  purchasedAt       DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

// Referral Models
model ReferralCode {
  id           String                @id @default(cuid())
  userId       String
  user         User                  @relation(fields: [userId], references: [id])
  code         String                @unique
  isActive     Boolean               @default(true)
  maxUses      Int?
  currentUses  Int                   @default(0)
  rewardType   String                @default("points") // points, discount, credit
  rewardValue  Int? // points amount or discount percentage
  expiresAt    DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  transactions ReferralTransaction[]
}

model ReferralTransaction {
  id           String       @id @default(cuid())
  codeId       String
  code         ReferralCode @relation(fields: [codeId], references: [id])
  referrerId   String
  referrer     User         @relation("ReferrerTransactions", fields: [referrerId], references: [id])
  refereeId    String
  referee      User         @relation("RefereeTransactions", fields: [refereeId], references: [id])
  orderId      String?
  order        Order?       @relation(fields: [orderId], references: [id])
  rewardAmount Int // points or discount amount
  status       String       @default("pending") // pending, awarded, expired
  createdAt    DateTime     @default(now())
  awardedAt    DateTime?
}

// Bulk Ordering Models
model BulkOrder {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id])
  merchantId  String
  merchant    Merchant         @relation(fields: [merchantId], references: [id])
  status      String           @default("pending") // pending, quoted, accepted, rejected, completed
  totalAmount Int? // ETB*100
  currency    String           @default("ETB")
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  items       BulkOrderItem[]
  quotes      BulkOrderQuote[]
}

model BulkOrderItem {
  id          String    @id @default(cuid())
  bulkOrderId String
  bulkOrder   BulkOrder @relation(fields: [bulkOrderId], references: [id])
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  skuId       String?
  sku         Sku?      @relation(fields: [skuId], references: [id])
  quantity    Float
  unitPrice   Int? // ETB*100
  totalPrice  Int? // ETB*100
  notes       String?
}

model BulkOrderQuote {
  id          String    @id @default(cuid())
  bulkOrderId String
  bulkOrder   BulkOrder @relation(fields: [bulkOrderId], references: [id])
  merchantId  String
  merchant    Merchant  @relation(fields: [merchantId], references: [id])
  totalAmount Int // ETB*100
  currency    String    @default("ETB")
  validUntil  DateTime
  notes       String?
  createdAt   DateTime  @default(now())
  acceptedAt  DateTime?
  rejectedAt  DateTime?
}

// Group Buy Models
model GroupBuy {
  id              String                @id @default(cuid())
  merchantId      String
  merchant        Merchant              @relation(fields: [merchantId], references: [id])
  productId       String
  product         Product               @relation(fields: [productId], references: [id])
  skuId           String?
  sku             Sku?                  @relation(fields: [skuId], references: [id])
  name            String
  description     String?
  targetQuantity  Float
  currentQuantity Float                 @default(0)
  pricePerUnit    Int // ETB*100
  currency        String                @default("ETB")
  status          String                @default("active") // active, completed, cancelled
  startsAt        DateTime
  endsAt          DateTime
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  participants    GroupBuyParticipant[]
}

model GroupBuyParticipant {
  id         String   @id @default(cuid())
  groupBuyId String
  groupBuy   GroupBuy @relation(fields: [groupBuyId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  quantity   Float
  status     String   @default("pending") // pending, confirmed, cancelled
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Inventory Movement Model
model InventoryMovement {
  id          String   @id @default(cuid())
  merchantId  String
  merchant    Merchant @relation(fields: [merchantId], references: [id])
  skuId       String
  sku         Sku      @relation(fields: [skuId], references: [id])
  type        String // addition, removal, adjustment, transfer, sale, return
  quantity    Float // positive for additions, negative for removals
  reason      String?
  referenceId String? // order ID, adjustment ID, etc.
  createdAt   DateTime @default(now())
  createdBy   String? // User ID who made the change
}

// Notification Model
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  type      String // order_update, price_alert, stock_notification, promotion, etc.
  title     String
  message   String
  data      Json? // Additional data for the notification
  read      Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}
